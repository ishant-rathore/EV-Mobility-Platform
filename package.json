{
  "name": "paypark",
  "version": "1.0.0",
  "description": "Pay&Park - Intelligent EV Mobility, Charging & Smart Parking Platform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently -n shared,api,web -c gray,cyan,magenta \"npm run dev:shared\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:shared": "npm run dev --workspace=@paypark/shared",
    "dev:backend": "npm run dev --workspace=@paypark/backend",
    "dev:frontend": "npm run dev --workspace=@paypark/frontend",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "npm run build --workspace=@paypark/shared",
    "build:backend": "npm run build --workspace=@paypark/backend",
    "build:frontend": "npm run build --workspace=@paypark/frontend",
    "start": "npm run start --workspace=@paypark/backend",
    "db:generate": "npm run db:generate --workspace=@paypark/backend",
    "db:push": "npm run db:push --workspace=@paypark/backend",
    "db:migrate": "npm run db:migrate --workspace=@paypark/backend",
    "db:seed": "npm run db:seed --workspace=@paypark/backend",
    "db:studio": "npm run db:studio --workspace=@paypark/backend",
    "db:reset": "npm run db:reset --workspace=@paypark/backend",
    "setup": "npm install && npm run build:shared && npm run db:generate && npm run db:push && npm run db:seed",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
