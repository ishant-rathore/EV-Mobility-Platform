{
  "name": "@ev-mobility/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema ../../database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../database/prisma/schema.prisma",
    "db:seed": "tsx ../../database/prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx ../../database/prisma/seed.ts"
  },
  "dependencies": {
    "@ev-mobility/charger-reliability": "*",
    "@ev-mobility/energy-engine": "*",
    "@ev-mobility/recommendation-engine": "*",
    "@ev-mobility/route-engine": "*",
    "@ev-mobility/station-ranking": "*",
    "@ev-mobility/traffic-engine": "*",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.14.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
