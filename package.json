{
  "name": "ev-mobility-platform",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --dir database prisma generate",
    "db:migrate": "pnpm --dir database prisma migrate dev",
    "db:seed": "pnpm --dir database seed"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest"
  }
}
