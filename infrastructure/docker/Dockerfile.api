FROM node:22-alpine AS build
WORKDIR /workspace
COPY . .
RUN npm ci --ignore-scripts && npm run prepare:packages && npm run build --workspace=@ev-mobility/api

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /workspace
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/backend/api/package.json ./backend/api/package.json
COPY --from=build /workspace/backend/api/dist ./backend/api/dist
COPY --from=build /workspace/intelligence ./intelligence
EXPOSE 3000
CMD ["node", "backend/api/dist/server.js"]
