// ─── Pay&Park — Prisma Schema ───────────────────────────────
// Full data model per PRD Section 13
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum UserRole {
  DRIVER
  OPERATOR
  ADMIN
}

enum JourneyStatus {
  PLANNING
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StationStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  UNKNOWN
}

enum ChargerStatus {
  AVAILABLE
  IN_USE
  OFFLINE
  MAINTENANCE
}

enum ConnectorType {
  CCS2
  CHAdeMO
  TYPE2_AC
  GBAC
  WALL_SOCKET
}

enum BayStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  UNKNOWN
}

enum ReservationStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  ARRIVING
  ACCESS_AUTHORIZED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  ERROR_REVIEW
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum DeviceType {
  SENSOR_ULTRASONIC
  SERVO_FLAP
  COMBINED
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum AccessAction {
  UNLOCK
  LOCK
  EMERGENCY_OVERRIDE
}

enum NotificationType {
  BOOKING_CONFIRMED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ARRIVAL_REMINDER
  SESSION_STARTED
  SESSION_COMPLETED
  DEVICE_OFFLINE
  LOW_SOC_ALERT
  GENERAL
}

// ─── Models ─────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(DRIVER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evProfiles    EVProfile[]
  journeys      Journey[]
  reservations  Reservation[]
  payments      Payment[]
  notifications Notification[]

  @@map("users")
}

model EVProfile {
  id                      String   @id @default(uuid())
  userId                  String
  vehicleModel            String
  batteryCapacityKWh      Float
  usableBatteryCapacityKWh Float?
  efficiencyWhPerKm       Float
  chargerTypes            ConnectorType[]
  currentSoc              Float    @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ev_profiles")
}

model Journey {
  id                  String        @id @default(uuid())
  userId              String
  originLat           Float
  originLng           Float
  destLat             Float
  destLng             Float
  routeDistanceKm     Float?
  estimatedDurationMin Float?
  estimatedEnergyKWh  Float?
  arrivalSoc          Float?
  chargingRequired    Boolean?
  status              JourneyStatus @default(PLANNING)
  requestedAt         DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargingPlan ChargingPlan?

  @@map("journeys")
}

model ChargingPlan {
  id                  String  @id @default(uuid())
  journeyId           String  @unique
  recommendedStationId String?
  requiredChargeKWh   Float?
  estimatedChargeCost Float?
  estimatedChargeTimeMin Float?
  stationRankings     Json?   // Array of {stationId, score, reasons[]}

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@map("charging_plans")
}

model ChargingStation {
  id           String        @id @default(uuid())
  provider     String?
  name         String
  latitude     Float
  longitude    Float
  address      String?
  status       StationStatus @default(ACTIVE)
  dataSource   String?       // "demo", "public_api", "operator"
  lastSyncedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  chargers     Charger[]
  parkingSite  ParkingSite?
  reservations Reservation[]

  @@map("charging_stations")
}

model Charger {
  id            String        @id @default(uuid())
  stationId     String
  connectorType ConnectorType
  powerKW       Float
  status        ChargerStatus @default(AVAILABLE)
  pricePerKWh   Float?

  station      ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  parkingBays  ParkingBay[]

  @@map("chargers")
}

model ParkingSite {
  id        String  @id @default(uuid())
  name      String
  address   String?
  latitude  Float
  longitude Float
  stationId String? @unique

  station ChargingStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  bays    ParkingBay[]

  @@map("parking_sites")
}

model ParkingBay {
  id          String    @id @default(uuid())
  siteId      String
  bayNumber   String
  status      BayStatus @default(AVAILABLE)
  chargerId   String?
  iotDeviceId String?   @unique

  site         ParkingSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  charger      Charger?         @relation(fields: [chargerId], references: [id], onDelete: SetNull)
  iotDevice    IoTDevice?       @relation(fields: [iotDeviceId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  occupancyEvents OccupancyEvent[]
  accessEvents    AccessEvent[]

  @@map("parking_bays")
}

model Reservation {
  id            String            @id @default(uuid())
  userId        String
  stationId     String
  chargerId     String
  parkingBayId  String?
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(DRAFT)
  totalAmount   Float             @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  station    ChargingStation @relation(fields: [stationId], references: [id])
  charger    Charger         @relation(fields: [chargerId], references: [id])
  parkingBay ParkingBay?     @relation(fields: [parkingBayId], references: [id])
  payment    Payment?
  accessEvents AccessEvent[]

  @@map("reservations")
}

model Payment {
  id                String        @id @default(uuid())
  reservationId     String        @unique
  userId            String
  amount            Float
  currency          String        @default("INR")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@map("payments")
}

model IoTDevice {
  id               String       @id @default(uuid())
  deviceIdentifier String       @unique
  type             DeviceType   @default(COMBINED)
  status           DeviceStatus @default(OFFLINE)
  lastHeartbeat    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  parkingBay      ParkingBay?
  occupancyEvents OccupancyEvent[]
  accessEvents    AccessEvent[]

  @@map("iot_devices")
}

model OccupancyEvent {
  id        String   @id @default(uuid())
  deviceId  String
  bayId     String
  occupied  Boolean
  timestamp DateTime @default(now())

  device IoTDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  bay    ParkingBay @relation(fields: [bayId], references: [id], onDelete: Cascade)

  @@map("occupancy_events")
}

model AccessEvent {
  id            String       @id @default(uuid())
  deviceId      String
  bayId         String
  reservationId String?
  action        AccessAction
  success       Boolean      @default(true)
  timestamp     DateTime     @default(now())

  device      IoTDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  bay         ParkingBay   @relation(fields: [bayId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@map("access_events")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
