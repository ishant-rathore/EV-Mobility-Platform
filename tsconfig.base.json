{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@paypark/shared/*": ["packages/shared/src/*"],
      "@paypark/backend/*": ["packages/backend/src/*"],
      "@paypark/frontend/*": ["packages/frontend/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}